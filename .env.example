# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MEM0_MCP_URL: The HTTP endpoint of the local Mem0 MCP server.
# Default port 8888 matches both Docker (-p 8888:8081) and pip (PORT=8888) setup in README.
# Leave unset to run in Mock mode (no Mem0 server required).
MEM0_MCP_URL="http://localhost:8888/mcp"

# MEM0_API_KEY: Your Mem0 account API key (starts with m0-).
# Required by the Mem0 MCP server itself — sign up free at https://mem0.ai.
# Not needed in Mock mode.
MEM0_API_KEY="m0-your-mem0-api-key-here"
